# ==========================================
# CONFIGURAÇÕES SMTP (GMAIL OU OUTRO PROVEDOR)
# ==========================================
# Insira seu e-mail e senha de aplicativo (App Password do Google)
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_aplicativo_aqui
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ==========================================
# PARÂMETROS DO REMETENTE (OPCIONAL)
# ==========================================
REMETENTE_NOME=Seu Nome
REMETENTE_EMPRESA=Sua Empresa
REMETENTE_DESCRICAO=descrição do seu serviço/produto
REMETENTE_WHATSAPP=5511999999999
EMPRESA_LINGUAS=Sua Escola de Idiomas
